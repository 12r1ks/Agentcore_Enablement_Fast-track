{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CustomerSupport",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CustomerSupport"
  },
  "runtimes": [
    {
      "name": "SupportAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/SupportAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "additionalPolicies": [
        "mantle-policy.json"
      ]
    }
  ],
  "memories": [
    {
      "name": "UserPreference",
      "eventExpiryDuration": 7,
      "strategies": [
        {
          "type": "USER_PREFERENCE"
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "support-gateway",
      "protocolType": "MCP",
      "description": "Lumora customer support tools",
      "targets": [
        {
          "name": "company-info",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "get_company_policy",
              "description": "Return one section of Lumora's official company information. Use it to answer questions about Lumora's policies and the company instead of guessing. Use it for guidance on how to handle customer support questions. The topic can be one of: about, contact, order_statuses, shipping, delays, returns, refunds, warranty, payment, privacy, escalation, faq.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string",
                    "description": "One of: about, contact, order_statuses, shipping, delays, returns, refunds, warranty, payment, privacy, escalation, faq."
                  }
                },
                "required": [
                  "topic"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "tools",
              "handler": "support_tools.handler.lambda_handler"
            },
            "pythonVersion": "PYTHON_3_13",
            "timeout": 10,
            "memorySize": 256
          }
        },
        {
          "name": "orders",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "get_orders",
              "description": "Get the current customer's orders. The customer is identified automatically from the session, so never ask for or pass a customer ID. Without order_id, returns a summary of all their orders (ID, status, date, total, item names), newest first; use it to list orders or find the one the customer means. With order_id, returns that order in full: items, totals, shipping and tracking, the delay reason if DELAYED, and refund history. Orders of other customers are reported as not found.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string",
                    "description": "Optional. The order ID to return in full, for example \"123\". Leave out to list all orders."
                  }
                }
              }
            },
            {
              "name": "get_customer_info",
              "description": "Get the current customer's profile: name, email, phone, country and shipping address. The customer is identified automatically from the session, so it takes no arguments.",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "tools",
              "handler": "support_tools.handler.lambda_handler"
            },
            "pythonVersion": "PYTHON_3_13",
            "timeout": 10,
            "memorySize": 256,
            "iamPolicy": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadOrdersAndCustomers",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem"
                  ],
                  "Resource": [
                    "arn:aws:dynamodb:eu-central-1:715075932719:table/CustomerSupport-orders",
                    "arn:aws:dynamodb:eu-central-1:715075932719:table/CustomerSupport-customers"
                  ]
                },
                {
                  "Sid": "ListOrdersByCustomer",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:Query"
                  ],
                  "Resource": "arn:aws:dynamodb:eu-central-1:715075932719:table/CustomerSupport-orders/index/customer_id-index"
                }
              ]
            }
          }
        },
        {
          "name": "refunds",
          "targetType": "lambda",
          "toolDefinitions": [
            {
              "name": "refund_customer",
              "description": "Refund part or all of one of the current customer's orders to their original payment method. The customer is identified automatically from the session, so never pass a customer ID; orders of other customers are reported as not found. Check the order with get_orders first. Refunds over 1000 EUR are not allowed and need a human support manager. Use a new idempotency_key for each new refund, and reuse the same key when retrying the same refund so it is not issued twice.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string",
                    "description": "The order ID to refund."
                  },
                  "amount": {
                    "type": "number",
                    "description": "Refund amount in the order's currency, with at most 2 decimal places."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Short reason for the refund, for example \"Faulty item\"."
                  },
                  "idempotency_key": {
                    "type": "string",
                    "description": "Unique ID for this refund operation, for example \"operation-123\"."
                  }
                },
                "required": [
                  "order_id",
                  "amount",
                  "reason",
                  "idempotency_key"
                ]
              }
            }
          ],
          "compute": {
            "host": "Lambda",
            "implementation": {
              "language": "Python",
              "path": "tools",
              "handler": "support_tools.handler.lambda_handler"
            },
            "pythonVersion": "PYTHON_3_13",
            "timeout": 10,
            "memorySize": 256,
            "iamPolicy": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadAndUpdateOrders",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": "arn:aws:dynamodb:eu-central-1:715075932719:table/CustomerSupport-orders"
                },
                {
                  "Sid": "ReadAndWriteRefundLedger",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": "arn:aws:dynamodb:eu-central-1:715075932719:table/CustomerSupport-refunds"
                }
              ]
            }
          }
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "SupportPolicies",
        "mode": "LOG_ONLY"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "SupportPolicies",
      "description": "Tool access rules for support-gateway",
      "policies": [
        {
          "name": "PermitCompanyInfo",
          "statement": "permit (principal == AgentCore::IamEntity::\"arn:aws:sts::715075932719:assumed-role/AgentCore-CustomerSupport-ApplicationAgentSupportAg-aaSeBABLnqht\", action == AgentCore::Action::\"company-info___get_company_policy\", resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:eu-central-1:715075932719:gateway/customersupport-support-gateway-klz7btjjhn\");",
          "validationMode": "IGNORE_ALL_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        },
        {
          "name": "PermitOrderReads",
          "statement": "permit (principal == AgentCore::IamEntity::\"arn:aws:sts::715075932719:assumed-role/AgentCore-CustomerSupport-ApplicationAgentSupportAg-aaSeBABLnqht\", action in [AgentCore::Action::\"orders___get_orders\",AgentCore::Action::\"orders___get_customer_info\"], resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:eu-central-1:715075932719:gateway/customersupport-support-gateway-klz7btjjhn\");",
          "validationMode": "IGNORE_ALL_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        },
        {
          "name": "PermitRefundUpToLimit",
          "statement": "permit (principal == AgentCore::IamEntity::\"arn:aws:sts::715075932719:assumed-role/AgentCore-CustomerSupport-ApplicationAgentSupportAg-aaSeBABLnqht\", action == AgentCore::Action::\"refunds___refund_customer\", resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:eu-central-1:715075932719:gateway/customersupport-support-gateway-klz7btjjhn\")\nwhen {\n    context.input.amount.lessThanOrEqual(decimal(\"1000.0\"))\n};",
          "validationMode": "FAIL_ON_ANY_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        },
        {
          "name": "ForbidRefundOverLimit",
          "statement": "forbid (principal, action == AgentCore::Action::\"refunds___refund_customer\", resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:eu-central-1:715075932719:gateway/customersupport-support-gateway-klz7btjjhn\")\nwhen {\n    context.input.amount.greaterThan(decimal(\"1000.0\"))\n};",
          "validationMode": "IGNORE_ALL_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        }
      ]
    }
  ],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}